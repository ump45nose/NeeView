<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:NeeView.Desktop">
  <!-- 视觉资源集中维护，查看器和页面业务不包含固定产品色彩。 -->
  <Styles.Resources>
    <SolidColorBrush x:Key="ReaderCanvasBrush">#15181D</SolidColorBrush>
    <SolidColorBrush x:Key="ReaderPlaceholderBrush">#262C35</SolidColorBrush>
    <SolidColorBrush x:Key="ReaderSelectionBrush">#4DA3FF</SolidColorBrush>
  </Styles.Resources>
  <Style Selector="local|ReaderView">
    <Setter Property="CanvasBrush" Value="{DynamicResource ReaderCanvasBrush}" />
    <Setter Property="PlaceholderBrush" Value="{DynamicResource ReaderPlaceholderBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource ReaderSelectionBrush}" />
  </Style>
  <Style Selector=":is(Window)"><Setter Property="FontSize" Value="14" /></Style>
  <Style Selector=":is(Window).reader-shell">
    <Setter Property="Width" Value="1280" /><Setter Property="Height" Value="860" />
    <Setter Property="MinWidth" Value="800" /><Setter Property="MinHeight" Value="480" />
  </Style>
  <Style Selector="TabItem"><Setter Property="Padding" Value="8,6" /></Style>
  <!-- 稳定样式类是页面调整入口，避免改动面板事件和文件操作流程。 -->
  <Style Selector="DockPanel.reader-toolbar"><Setter Property="Margin" Value="6" /></Style>
  <Style Selector="Button.reader-action"><Setter Property="Margin" Value="2" /></Style>
  <Style Selector="TextBox.reader-address"><Setter Property="MinWidth" Value="200" /></Style>
  <Style Selector="TextBlock.reader-status"><Setter Property="Margin" Value="8,4" /></Style>
  <Style Selector="StackPanel.reader-page-row">
    <Setter Property="Spacing" Value="8" /><Setter Property="Margin" Value="4" />
  </Style>
  <Style Selector="TextBlock.reader-page-name"><Setter Property="MaxWidth" Value="170" /></Style>
  <Style Selector="TextBlock.reader-list-label"><Setter Property="Margin" Value="4" /></Style>
  <Style Selector="TextBlock.reader-information"><Setter Property="Margin" Value="10" /></Style>
  <Style Selector="TextBlock.reader-destination-label"><Setter Property="Margin" Value="6" /></Style>
  <Style Selector="TextBlock.reader-section-title"><Setter Property="Margin" Value="6" /></Style>
  <Style Selector="local|ThumbnailView">
    <Setter Property="Width" Value="48" /><Setter Property="Height" Value="64" />
  </Style>
  <Style Selector=":is(Window).reader-settings">
    <Setter Property="Width" Value="760" /><Setter Property="Height" Value="650" />
  </Style>
  <Style Selector="DockPanel.reader-settings-root"><Setter Property="Margin" Value="16" /></Style>
  <Style Selector="StackPanel.reader-shortcuts"><Setter Property="Spacing" Value="8" /></Style>
  <Style Selector="TextBlock.reader-help"><Setter Property="Margin" Value="0,8" /></Style>
  <Style Selector="StackPanel.reader-settings-group">
    <Setter Property="Spacing" Value="12" /><Setter Property="Margin" Value="12" />
  </Style>
  <Style Selector="StackPanel.reader-policy-row"><Setter Property="Spacing" Value="12" /></Style>
  <Style Selector="ComboBox.reader-policy-value"><Setter Property="MinWidth" Value="230" /></Style>
  <Style Selector="TextBlock.reader-policy-label"><Setter Property="Width" Value="130" /></Style>
  <Style Selector="StackPanel.reader-dialog-actions"><Setter Property="Spacing" Value="8" /></Style>
  <Style Selector="TextBlock.reader-settings-feedback"><Setter Property="MaxWidth" Value="460" /></Style>
  <Style Selector="ComboBox.reader-option-choice"><Setter Property="MinWidth" Value="280" /></Style>
</Styles>
