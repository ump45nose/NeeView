<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NeeView.Desktop.MainWindow"
        Classes="reader-shell" Title="NeeView · macOS"
        Width="1280" Height="860" MinWidth="800" MinHeight="480">
  <!-- 只定义页面结构与稳定插槽；按钮标签关联命令，业务由代码适配器转交工作区。 -->
  <DockPanel>
    <DockPanel DockPanel.Dock="Top" Classes="reader-toolbar">
      <WrapPanel DockPanel.Dock="Bottom">
        <Button Classes="reader-action" Content="打开" Tag="Open" Click="OnToolbarClick" />
        <Button Classes="reader-action" Content="‹" Tag="PrevPage" Click="OnToolbarClick" />
        <Button Classes="reader-action" Content="›" Tag="NextPage" Click="OnToolbarClick" />
        <Button Classes="reader-action" Content="分页" Tag="Paged" Click="OnToolbarClick" />
        <Button Classes="reader-action" Content="连续" Tag="Continuous" Click="OnToolbarClick" />
        <Button Classes="reader-action" Content="瀑布流" Tag="Masonry" Click="OnToolbarClick" />
        <Button Classes="reader-action" Content="双页" Tag="ToggleDouble" Click="OnToolbarClick" />
        <Button Classes="reader-action" Content="方向" Tag="ToggleDirection" Click="OnToolbarClick" />
        <Button Classes="reader-action" Content="适应" Tag="Fit" Click="OnToolbarClick" />
        <Button Classes="reader-action" Content="100%" Tag="ActualPixels" Click="OnToolbarClick" />
        <Button Classes="reader-action" Content="书签" Tag="Bookmark" Click="OnToolbarClick" />
        <Button Classes="reader-action" Content="设置" Tag="Settings" Click="OnToolbarClick" />
        <Button Classes="reader-action" Content="导入" Tag="Import" Click="OnToolbarClick" />
      </WrapPanel>
      <TextBox x:Name="AddressField" Classes="reader-address" PlaceholderText="图片、目录或 ZIP / RAR / 7z 路径" />
    </DockPanel>
    <StackPanel DockPanel.Dock="Bottom">
      <Slider x:Name="PositionField" Minimum="0" Maximum="1" />
      <TextBlock x:Name="StatusField" Classes="reader-status" TextTrimming="CharacterEllipsis" />
    </StackPanel>
    <!-- 五个固定列是侧栏宽度持久化契约；内部控件与模板可独立替换。 -->
    <Grid x:Name="BodyGrid" ColumnDefinitions="240,5,*,5,260">
      <ContentControl x:Name="NavigationHost" Grid.Column="0" />
      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
      <ScrollViewer x:Name="ViewerScroll" Grid.Column="2" HorizontalScrollBarVisibility="Auto" />
      <GridSplitter Grid.Column="3" ResizeDirection="Columns" />
      <ContentControl x:Name="DestinationsHost" Grid.Column="4" />
    </Grid>
  </DockPanel>
</Window>
