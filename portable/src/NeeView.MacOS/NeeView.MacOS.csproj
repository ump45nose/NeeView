<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-macos</TargetFramework>
    <!-- 固定当前 workload 的 API 版本，Library 编译检查与 Exe 还原使用相同锁文件。 -->
    <TargetPlatformVersion>27.0</TargetPlatformVersion>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <RootNamespace>NeeView.MacOS</RootNamespace>
    <!-- 原配置依赖运行时类型与 JSON 反射；P1 不引入 AOT/裁剪改造。 -->
    <LinkMode>None</LinkMode>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../NeeView.Engine/NeeView.Engine.csproj" />
    <ProjectReference Include="../NeeView.Backends/NeeView.Backends.csproj" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>
</Project>
