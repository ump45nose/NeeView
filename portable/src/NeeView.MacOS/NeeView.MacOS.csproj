<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-macos</TargetFramework>
    <!-- 固定当前 workload 的 API 版本，Library 编译检查与 Exe 还原使用相同锁文件。 -->
    <TargetPlatformVersion>27.0</TargetPlatformVersion>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <RootNamespace>NeeView.MacOS</RootNamespace>
    <!-- 原配置依赖运行时类型与 JSON 反射；P1 不引入 AOT/裁剪改造。 -->
    <LinkMode>None</LinkMode>
    <!-- SDK 调整原生库加载路径后必须重新签名；本地默认 ad-hoc，不需要开发者证书。 -->
    <EnableCodeSigning Condition="'$(EnableCodeSigning)' == ''">true</EnableCodeSigning>
    <CodesignKey Condition="'$(CodesignKey)' == ''">-</CodesignKey>
    <CodesignEntitlements>../../scripts/entitlements.plist</CodesignEntitlements>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Styles/AppLogo.png" />
    <BundleResource Include="../../../LICENSE.md" LogicalName="LICENSE.md" />
    <ProjectReference Include="../NeeView.Engine/NeeView.Engine.csproj" />
    <ProjectReference Include="../NeeView.Backends/NeeView.Backends.csproj" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>
  <ItemGroup>
    <!-- 迁入纯源码依赖也随正式 .app 保存原版权/许可通知。 -->
    <BundleResource Include="../NeeView.Engine/Search/Upstream/LICENSE.md" LogicalName="Licenses/NeeLaboratory.IO.Search.LICENSE.txt" />
    <BundleResource Include="../NeeView.Engine/Search/Upstream/THIRDPARTY_LICENSES.md" LogicalName="Licenses/NeeLaboratory.IO.Search.THIRDPARTY.txt" />
  </ItemGroup>
</Project>
