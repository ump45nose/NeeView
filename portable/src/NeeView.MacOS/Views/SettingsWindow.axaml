<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="NeeView.MacOS.Views.SettingsWindow" Width="900" Height="620" Title="选项" x:CompileBindings="False" WindowStartupLocation="CenterOwner">
  <!-- 沿用原设置窗口左导航/搜索、右内容布局；高级页面保留迁移状态。 -->
  <Grid RowDefinitions="*,Auto" ColumnDefinitions="190,*">
    <Border Grid.Column="0" Classes="panel">
      <Grid RowDefinitions="Auto,*">
        <StackPanel x:Name="SettingsSearchInput" Margin="8" Spacing="4">
          <Grid ColumnDefinitions="*,Auto,Auto"><TextBox x:Name="SettingsSearchBox" Text="{Binding Keyword, Mode=TwoWay}" PlaceholderText="搜索设置" KeyDown="SettingsSearch_KeyDown" TextChanged="SettingsSearch_TextChanged" ToolTip.Tip="原结构化搜索：空格 AND，/or，/not，/word，/re。Enter 确认并加入本窗口历史。" /><Button x:Name="SettingsSearchHistory" Grid.Column="1" Content="⌄" Click="SettingsSearch_History" /><Button x:Name="SettingsSearchClear" Grid.Column="2" Content="×" Click="SettingsSearch_Clear" /></Grid>
          <TextBlock x:Name="SettingsSearchError" Text="{Binding Error}" TextWrapping="Wrap" />
        </StackPanel>
        <ListBox x:Name="SettingsNavigation" Grid.Row="1" SelectedIndex="0" SelectionChanged="Navigation_Changed"><ListBoxItem Content="书籍 / 阅读" /><ListBoxItem Content="命令 / 键鼠" /><ListBoxItem Content="胶片条 / 滑条" /><ListBoxItem Content="窗口 / 自动隐藏" /><ListBoxItem Content="历史记录" /><ListBoxItem Content="页面列表 / 书架" /><ListBoxItem Content="文件操作" /><ListBoxItem Content="主题 / 配色" /><ListBoxItem Content="字体" /><ListBoxItem Content="归档 / PDF" /><ListBoxItem Content="图像效果（P5）" IsEnabled="False" /><ListBoxItem Content="导入旧配置（P5）" IsEnabled="False" /></ListBox>
      </Grid>
    </Border>
    <ScrollViewer x:Name="ArchiveSettings" Grid.Column="1" IsVisible="False">
      <StackPanel Margin="24" Spacing="12">
        <TextBlock Classes="settings-section" Text="PDF" FontSize="{DynamicResource SystemFontSizeHuge}" />
        <CheckBox x:Name="PdfEnabled" Content="启用 PDF 读取" IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
        <TextBlock Text="支持的扩展名" />
        <TextBox x:Name="PdfFileTypes" AutomationProperties.Name="PDF 扩展名" Text="{Binding SupportFileTypes, Mode=TwoWay}" />
        <TextBlock Text="用分号分隔，例如 .pdf;.document。留空关闭 PDF 格式识别。" TextWrapping="Wrap" />
        <TextBlock Text="默认渲染尺寸（像素）" />
        <Grid ColumnDefinitions="*,Auto,*"><NumericUpDown x:Name="PdfWidth" AutomationProperties.Name="PDF 渲染宽度" Value="{Binding RenderWidth, Mode=TwoWay}" Minimum="256" Maximum="{Binding RenderWidthMaximum}" Increment="128" /><TextBlock Grid.Column="1" Text=" × " VerticalAlignment="Center" /><NumericUpDown x:Name="PdfHeight" Grid.Column="2" AutomationProperties.Name="PDF 渲染高度" Value="{Binding RenderHeight, Mode=TwoWay}" Minimum="256" Maximum="{Binding RenderHeightMaximum}" Increment="128" /></Grid>
        <TextBlock Text="保持页面比例；普通显示按原规则选择渲染规格，提取/复制使用默认流。" TextWrapping="Wrap" />
        <TextBlock Classes="settings-section" Text="源图像尺寸" FontSize="{DynamicResource SystemFontSizeLarge}" />
        <CheckBox x:Name="PdfLimitSource" Content="限制源尺寸（当前用于 PDF 页面）" IsChecked="{Binding IsLimitSourceSize, Mode=TwoWay}" />
        <Grid ColumnDefinitions="*,Auto,*"><NumericUpDown x:Name="PdfMaximumWidth" AutomationProperties.Name="最大源宽度" Value="{Binding MaximumWidth, Mode=TwoWay}" Minimum="1024" Maximum="{Binding MaximumWidthMaximum}" Increment="256" /><TextBlock Grid.Column="1" Text=" × " VerticalAlignment="Center" /><NumericUpDown x:Name="PdfMaximumHeight" Grid.Column="2" AutomationProperties.Name="最大源高度" Value="{Binding MaximumHeight, Mode=TwoWay}" Minimum="1024" Maximum="{Binding MaximumHeightMaximum}" Increment="256" /></Grid>
        <TextBlock Text="保存后用于后续尺寸探测及渲染；已打开页面不会因修改表单重新扫描。密码/分卷读取尚未迁入。" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>
    <ScrollViewer x:Name="FontSettings" Grid.Column="1" IsVisible="False">
      <StackPanel Margin="24" Spacing="12">
        <TextBlock Classes="settings-section" Text="字体" FontSize="{DynamicResource SystemFontSizeHuge}" />
        <TextBlock Text="字体名" />
        <ComboBox x:Name="FontChoice" ItemsSource="{Binding FontNames}" SelectedItem="{Binding FontName, Mode=TwoWay}" />
        <TextBlock Text="常规字号（%）" /><NumericUpDown x:Name="FontPercent" Value="{Binding FontPercent, Mode=TwoWay}" Minimum="{Binding FontMinimum}" Maximum="{Binding FontMaximum}" Increment="5" FormatString="0.#####" />
        <TextBlock Text="菜单字号（%）" /><NumericUpDown x:Name="MenuFontPercent" Value="{Binding MenuPercent, Mode=TwoWay}" Minimum="{Binding MenuMinimum}" Maximum="{Binding MenuMaximum}" Increment="5" FormatString="0.#####" />
        <TextBlock Text="文件夹树字号（%）" /><NumericUpDown x:Name="TreeFontPercent" Value="{Binding TreePercent, Mode=TwoWay}" Minimum="{Binding TreeMinimum}" Maximum="{Binding TreeMaximum}" Increment="5" FormatString="0.#####" />
        <TextBlock Text="面板字号（%）" /><NumericUpDown x:Name="PanelFontPercent" Value="{Binding PanelPercent, Mode=TwoWay}" Minimum="{Binding PanelMinimum}" Maximum="{Binding PanelMaximum}" Increment="5" FormatString="0.#####" />
        <CheckBox x:Name="ClearTypeFont" Content="ClearType（Windows 配置，Mac 使用系统文字渲染）" IsChecked="{Binding IsClearTypeEnabled}" IsEnabled="False" />
        <TextBlock Text="100% 对应系统字号；常用调整范围 100–200%。未安装的旧字体保留名称，显示时使用系统默认字体。保存后应用，取消保留当前字体。" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>
    <ScrollViewer x:Name="ThemeSettings" Grid.Column="1" IsVisible="False">
      <StackPanel Margin="24" Spacing="14">
        <TextBlock Classes="settings-section" Text="主题 / 配色" FontSize="20" />
        <TextBlock Text="主题" />
        <ComboBox x:Name="ThemeChoice" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}">
          <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="自定义主题目录" />
        <TextBox x:Name="ThemeFolder" Text="{Binding Folder, Mode=TwoWay}" />
        <WrapPanel><Button x:Name="ChooseThemeFolder" Content="选择目录…" Click="ChooseThemeFolder_Click" Margin="0,0,12,8" /><Button x:Name="RefreshThemes" Content="刷新主题列表" Click="RefreshThemes_Click" Margin="0,0,12,8" /><Button x:Name="OpenThemeFolder" Content="打开自定义主题文件夹" Click="OpenThemeFolder_Click" Margin="0,0,0,8" /></WrapPanel>
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
        <TextBlock Text="布局保持不变；保存后应用配色，取消保留当前主题。" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>
    <ScrollViewer x:Name="NavigationSettings" Grid.Column="1" IsVisible="False">
      <StackPanel Margin="24" Spacing="12">
        <TextBlock Classes="settings-section" Text="页面列表 / 书架" FontSize="20" />
        <TextBlock Text="页面名称" /><ComboBox x:Name="PageNameFormat"><ComboBoxItem Content="智能名称" /><ComboBoxItem Content="仅文件名" /><ComboBoxItem Content="完整条目名" /><ComboBoxItem Content="页码" /></ComboBox>
        <TextBlock Text="页面列表样式" /><ComboBox x:Name="PageListStyle"><ComboBoxItem Content="普通列表" /><ComboBoxItem Content="详细内容" /><ComboBoxItem Content="横幅" /><ComboBoxItem Content="缩略图" /></ComboBox>
        <CheckBox x:Name="PageShowBookTitle" Content="显示书名" /><CheckBox x:Name="PageGroupBy" Content="按目录分组" /><CheckBox x:Name="PageShowSearch" Content="显示页面搜索框" /><CheckBox x:Name="PageShowCount" Content="显示项目数" /><CheckBox x:Name="PageFocusMain" Content="确认页面后焦点回正文" />
        <CheckBox x:Name="PageTreeVisible" Content="显示页面目录组树" /><ComboBox x:Name="PageTreeLayout" AutomationProperties.Name="页面目录组树位置"><ComboBoxItem Content="上方" /><ComboBoxItem Content="左侧" /></ComboBox>
        <TextBlock Text="页面树宽 / 高 (DIP)" /><NumericUpDown x:Name="PageTreeWidth" Minimum="48" Maximum="2048" /><NumericUpDown x:Name="PageTreeHeight" Minimum="40" Maximum="2048" />
        <TextBlock Classes="settings-section" Text="普通书架" FontSize="16" Margin="0,8,0,0" />
        <CheckBox x:Name="FolderShowSearch" Content="显示书架搜索框" /><CheckBox x:Name="FolderSearchRecursive" Content="搜索包含子目录" />
        <CheckBox x:Name="FolderTreeVisible" Content="显示普通目录树" /><ComboBox x:Name="FolderTreeLayout" AutomationProperties.Name="普通目录树位置"><ComboBoxItem Content="上方" /><ComboBoxItem Content="左侧" /></ComboBox>
        <TextBlock Text="书架树宽 / 高 (DIP)" /><NumericUpDown x:Name="FolderTreeWidth" Minimum="48" Maximum="2048" /><NumericUpDown x:Name="FolderTreeHeight" Minimum="40" Maximum="2048" />
        <CheckBox x:Name="FolderTreeSync" Content="同步按钮同时同步目录树" /><CheckBox x:Name="FolderTreeAutoSync" Content="自动同步目录树" />
        <TextBlock Classes="settings-section" Text="搜索（全局）" FontSize="16" Margin="0,8,0,0" /><CheckBox x:Name="IncrementalSearch" Content="逐次搜索（500ms合并输入）" /><CheckBox x:Name="KeepSearchHistory" Content="保存搜索表达式历史" />
      </StackPanel>
    </ScrollViewer>
    <ScrollViewer x:Name="ReadingSettings" Grid.Column="1">
      <StackPanel Margin="24" Spacing="14">
        <TextBlock Classes="settings-section" Text="书籍 / 阅读" FontSize="20" />
        <ComboBox x:Name="Scope" AutomationProperties.Name="阅读设置作用域：当前书籍 / 默认阅读设置" SelectedIndex="0" SelectionChanged="Scope_Changed"><ComboBoxItem Content="当前书籍" /><ComboBoxItem Content="默认阅读设置" /></ComboBox>
        <TextBlock Text="页面模式" /><ComboBox x:Name="Mode" SelectedIndex="0"><ComboBoxItem Content="单页" /><ComboBoxItem Content="双页" /></ComboBox>
        <TextBlock Text="阅读方向" /><ComboBox x:Name="Order" SelectedIndex="0"><ComboBoxItem Content="从右向左" /><ComboBoxItem Content="从左向右" /></ComboBox>
        <CheckBox x:Name="Divide" Content="单页模式分割横向页面" /><CheckBox x:Name="Wide" Content="双页模式宽图独占一页" />
        <CheckBox x:Name="First" Content="首页单独显示" /><CheckBox x:Name="Last" Content="末页单独显示" />
        <TextBlock Text="书籍基准缩放（独立于手工缩放）" /><NumericUpDown x:Name="BaseScale" Minimum="0.1" Maximum="2" Increment="0.05" FormatString="0.#####" />
        <TextBlock Text="页尾动作" /><ComboBox x:Name="PageEndAction"><ComboBoxItem Content="停止并提示" /><ComboBoxItem Content="前后书" /><ComboBoxItem Content="循环本书" /><ComboBoxItem Content="无缝循环" /><ComboBoxItem Content="询问" /></ComboBox>
        <TextBlock Text="页尾切书位置" /><ComboBox x:Name="ResetNextBookPageMode"><ComboBoxItem Content="恢复阅读位置" /><ComboBoxItem Content="始终从首页开始" /><ComboBoxItem Content="连续阅读（向前首页 / 向后末页）" /></ComboBox>
        <CheckBox x:Name="NotifyPageLoop" Content="提示页面已循环" />
        <TextBlock Text="页框移动方向" /><ComboBox x:Name="PageOrientation"><ComboBoxItem Content="水平" /><ComboBoxItem Content="垂直" /></ComboBox>
        <TextBlock Text="全景帧间隔 (DIP)" /><NumericUpDown x:Name="FrameSpace" Minimum="-32" Maximum="32" Increment="1" FormatString="0.#####" />
        <TextBlock Text="翻页过渡" /><ComboBox x:Name="PageMoveType"><ComboBoxItem Content="滚动" /><ComboBoxItem Content="淡入淡出" /></ComboBox>
        <TextBlock Text="翻页时长（秒，0 为立即）" /><NumericUpDown x:Name="PageMoveDuration" Minimum="0" Maximum="1" Increment="0.1" FormatString="0.#####" />
        <TextBlock Text="命令滚动时长（秒）" /><NumericUpDown x:Name="ScrollDuration" Minimum="0" Maximum="1" Increment="0.1" FormatString="0.#####" />
        <CheckBox x:Name="HoverScroll" Content="指针悬停滚动（禁用四向 / N 型滚动命令）" />
        <TextBlock Text="悬停滚动灵敏度 / 时长" /><NumericUpDown x:Name="HoverSensitivity" Minimum="1" Maximum="10" Increment="0.1" /><NumericUpDown x:Name="HoverDuration" Minimum="0" Maximum="1" Increment="0.1" />
        <CheckBox x:Name="MouseWheelScroll" Content="无修饰滚轮连续滚动（优先于滚轮命令）" />
        <TextBlock Text="连续滚轮灵敏度 / 时长" /><NumericUpDown x:Name="WheelSensitivity" Minimum="0" Maximum="2" Increment="0.1" /><NumericUpDown x:Name="WheelDuration" Minimum="0" Maximum="1" Increment="0.1" />
        <TextBlock Classes="settings-section" Text="书架（全局）" FontSize="16" Margin="0,8,0,0" />
        <TextBlock Text="文件夹与归档排序" /><ComboBox x:Name="BookshelfGroup"><ComboBoxItem Content="混排" /><ComboBoxItem Content="文件夹在前" /><ComboBoxItem Content="文件夹在后" /></ComboBox>
        <CheckBox x:Name="PrioritizeBookMove" Content="允许前后书命令取代正在加载的书籍" />
        <CheckBox x:Name="OpenLastFolder" Content="启动时恢复上次书架位置" />
        <CheckBox x:Name="OpenLastBookmarkFolder" Content="启动时恢复独立书签列表位置" />
        <TextBlock Classes="settings-section" Text="查看器（全局）" FontSize="16" Margin="0,8,0,0" />
        <CheckBox x:Name="BaseScaleEnabled" Content="启用书籍基准缩放" />
        <TextBlock Text="缩放中心" /><ComboBox x:Name="ScaleCenter" />
        <TextBlock Text="旋转中心" /><ComboBox x:Name="RotateCenter" />
        <TextBlock Text="翻转中心" /><ComboBox x:Name="FlipCenter" />
        <TextBlock Text="旋转吸附步长（度，0 为关闭）" /><NumericUpDown x:Name="AngleFrequency" Minimum="0" Maximum="180" Increment="1" FormatString="0.#####" />
        <CheckBox x:Name="KeepScale" Content="翻页保持缩放" /><CheckBox x:Name="KeepScaleBooks" Content="切书也保持缩放（需启用翻页保持）" />
        <CheckBox x:Name="KeepAngle" Content="翻页保持旋转" /><CheckBox x:Name="KeepAngleBooks" Content="切书也保持旋转（需启用翻页保持）" />
        <CheckBox x:Name="KeepFlip" Content="翻页保持翻转" /><CheckBox x:Name="KeepFlipBooks" Content="切书也保持翻转（需启用翻页保持）" />
        <CheckBox x:Name="KeepPageTransform" Content="分别记住当前书中每页的变换" /><CheckBox x:Name="ScaleStretchTracking" Content="缩放跟随窗口适配" />
        <TextBlock Text="页面水平起点" /><ComboBox x:Name="ViewHorizontalOrigin" />
        <TextBlock Text="页面垂直起点" /><ComboBox x:Name="ViewVerticalOrigin" />
        <TextBlock Text="居中范围比例" /><NumericUpDown x:Name="ViewOriginCenterRatio" Minimum="1" Maximum="2" Increment="0.1" FormatString="0.#####" />
        <TextBlock Text="移动限制" /><ComboBox x:Name="MovementConstraint"><ComboBoxItem Content="无限制" /><ComboBoxItem Content="限制在视口内" /><ComboBoxItem Content="尺寸溢出前锁定" /><ComboBoxItem Content="吸附边界" /></ComboBox>
      </StackPanel>
    </ScrollViewer>
    <Grid x:Name="InputSettings" Grid.Column="1" RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="16" IsVisible="False">
      <TextBlock Classes="settings-section" Text="命令 / 键鼠" FontSize="20" Margin="0,0,0,12" />
      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
        <ComboBox x:Name="InputScheme" AutomationProperties.Name="默认键位方案"><ComboBoxItem Content="A · 标准" /><ComboBoxItem Content="B · 滚轮翻页" /><ComboBoxItem Content="C · 点击翻页" /></ComboBox>
        <ComboBox x:Name="InputReadOrder" AutomationProperties.Name="默认键位阅读方向"><ComboBoxItem Content="从右向左" /><ComboBoxItem Content="从左向右" /></ComboBox>
        <Button x:Name="InputDefaults" Content="应用默认键位" Click="InputDefaults_Click" ToolTip.Tip="替换键位编辑副本；保存后生效。命令参数保留。" />
      </StackPanel>
      <StackPanel Grid.Row="2" Margin="0,0,0,8">
        <CheckBox x:Name="ReversePageMove" Content="按滑条方向交换成对的按键 / 点击操作" />
        <StackPanel Orientation="Horizontal" Spacing="12"><CheckBox x:Name="ReversePageWheel" Content="垂直滚轮也交换" /><CheckBox x:Name="ReverseHorizontalWheel" Content="水平滚轮也交换" /><CheckBox x:Name="LimitHorizontalWheel" Content="水平滚轮每次最多一步" /></StackPanel>
      </StackPanel>
      <StackPanel Grid.Row="3" Spacing="6"><StackPanel Orientation="Horizontal" Spacing="12"><CheckBox x:Name="GestureEnabled" Content="启用右键方向手势" /><TextBlock Text="最小距离 (DIP)" VerticalAlignment="Center" /><NumericUpDown x:Name="GestureDistance" Minimum="5" Maximum="200" Increment="5" Width="130" /></StackPanel><TextBox PlaceholderText="搜索命令" TextChanged="InputSearch_Changed" Margin="0,0,0,8" /></StackPanel>
      <ListBox x:Name="InputList" Grid.Row="4">
        <ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,180,90,Auto" Margin="0,4"><StackPanel><TextBlock Text="{Binding Label}" /><TextBlock Text="{Binding Name}" FontSize="10" Opacity="0.6" /></StackPanel><TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" ToolTip.Tip="逗号分隔多个输入；空值解绑。Control 保留原值，Mac Command 使用 Meta。" /><TextBox Grid.Column="2" Margin="6,0,0,0" Text="{Binding MouseGesture, Mode=TwoWay}" ToolTip.Tip="方向手势：U 上、R 右、D 下、L 左、C 点击；空值解绑。" /><Button Grid.Column="3" Content="参数…" Margin="8,0,0,0" IsEnabled="{Binding HasParameters}" Click="Parameter_Click" /></Grid></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
    </Grid>
    <ScrollViewer x:Name="FilmSettings" Grid.Column="1" IsVisible="False">
      <StackPanel Margin="24" Spacing="14">
        <TextBlock Classes="settings-section" Text="胶片条 / 滑条" FontSize="20" />
        <CheckBox x:Name="FilmEnabled" Content="显示胶片条" /><CheckBox x:Name="FilmHide" Content="自动隐藏胶片条" />
        <TextBlock Text="缩略图宽度（DIP，最低 32）" /><NumericUpDown x:Name="FilmWidth" Minimum="32" Increment="8" FormatString="0.#####" />
        <CheckBox x:Name="FilmNumber" Content="显示页码" /><CheckBox x:Name="FilmCenter" Content="所选图片居中（首尾保留空白）" /><CheckBox x:Name="FilmDetail" Content="悬停显示页面详情" />
        <TextBlock Text="胶片条滚轮动作" /><ComboBox x:Name="FilmWheel"><ComboBoxItem Content="移动选择（点击或 Enter 确认）" /><ComboBoxItem Content="移动正文页" /><ComboBoxItem Content="使用命令绑定" /></ComboBox>
        <TextBlock Text="胶片条与滑条方向" /><ComboBox x:Name="SliderOrder"><ComboBoxItem Content="从左向右" /><ComboBoxItem Content="从右向左" /><ComboBoxItem Content="跟随书籍阅读方向" /></ComboBox>
        <CheckBox x:Name="SliderLinked" Content="滑条与胶片条联动（拖动预览，释放确认）" /><CheckBox x:Name="SliderSync" Content="滑条步进跟随页面模式" />
        <CheckBox x:Name="SliderEnabled" Content="显示页面滑条" />
        <TextBlock Text="滑条页号位置（点击页号可直接编辑）" /><ComboBox x:Name="SliderIndexLayout"><ComboBoxItem Content="不显示" /><ComboBoxItem Content="左侧" /><ComboBoxItem Content="右侧" /></ComboBox>
        <TextBlock Text="滑条厚度（DIP，15–50）" /><NumericUpDown x:Name="SliderThickness" Minimum="15" Maximum="50" Increment="1" FormatString="0.#####" />
        <TextBlock Text="滑条不透明度（0–1）" /><NumericUpDown x:Name="SliderOpacity" Minimum="0" Maximum="1" Increment="0.05" FormatString="0.#####" />
        <TextBlock Text="滑条滚轮动作" /><ComboBox x:Name="SliderWheel"><ComboBoxItem Content="移动正文页" /><ComboBoxItem Content="使用命令绑定" /></ComboBox>
        <CheckBox x:Name="SliderHide" Content="自动隐藏滑条（胶片条一起弹出）" /><CheckBox x:Name="SliderModeHide" Content="自动隐藏模式下隐藏滑条" /><CheckBox x:Name="FilmModeHide" Content="自动隐藏模式下隐藏胶片条" />
        <CheckBox x:Name="SliderMarks" Content="滑条显示播放列表标记" /><CheckBox x:Name="FilmMarks" Content="胶片条显示播放列表标记" />
        <TextBlock Text="指定页数步进（上一方向、下一方向共用）" /><NumericUpDown x:Name="MoveSize" Minimum="0" Maximum="1000" Increment="1" FormatString="0" />
      </StackPanel>
    </ScrollViewer>
    <ScrollViewer x:Name="AutoHideSettings" Grid.Column="1" IsVisible="False">
      <StackPanel Margin="24" Spacing="14">
        <TextBlock Classes="settings-section" Text="窗口 / 自动隐藏" FontSize="20" />
        <TextBlock Classes="settings-section" Text="启用自动隐藏模式" FontSize="16" />
        <CheckBox x:Name="AutoNormal" Content="普通窗口" /><CheckBox x:Name="AutoMaximized" Content="最大化窗口" /><CheckBox x:Name="AutoFullScreen" Content="全屏窗口" />
        <TextBlock Classes="settings-section" Text="菜单 / 侧栏" FontSize="16" />
        <CheckBox x:Name="AddressEnabled" Content="显示地址栏" /><CheckBox x:Name="SideBarEnabled" Content="显示侧栏图标" />
        <CheckBox x:Name="MenuHide" Content="自动隐藏菜单和地址栏" /><CheckBox x:Name="MenuModeHide" Content="自动隐藏模式下隐藏菜单和地址栏" />
        <CheckBox x:Name="LeftHide" Content="自动隐藏左侧栏" /><CheckBox x:Name="RightHide" Content="自动隐藏右侧栏" />
        <CheckBox x:Name="LeftModeHide" Content="自动隐藏模式下隐藏左侧栏" /><CheckBox x:Name="RightModeHide" Content="自动隐藏模式下隐藏右侧栏" />
        <TextBlock Classes="settings-section" Text="延迟与边缘触发" FontSize="16" />
        <TextBlock Text="隐藏延迟（秒）" /><NumericUpDown x:Name="HideDelay" Minimum="0" Maximum="60" Increment="0.1" FormatString="0.#####" />
        <TextBlock Text="显示延迟（秒）" /><NumericUpDown x:Name="ShowDelay" Minimum="0" Maximum="60" Increment="0.1" FormatString="0.#####" />
        <CheckBox x:Name="KeyDelay" Content="按键延长所属区域的隐藏延迟" />
        <TextBlock Text="左右边缘宽度（DIP）" /><NumericUpDown x:Name="HorizontalMargin" Minimum="0" Maximum="500" FormatString="0.#####" />
        <TextBlock Text="上下边缘宽度（DIP）" /><NumericUpDown x:Name="VerticalMargin" Minimum="0" Maximum="500" FormatString="0.#####" />
        <TextBlock Text="焦点锁定" /><ComboBox x:Name="FocusLock"><ComboBoxItem Content="无" /><ComboBoxItem Content="逻辑焦点" /><ComboBoxItem Content="文本逻辑焦点" /><ComboBoxItem Content="实际焦点" /><ComboBoxItem Content="文本实际焦点" /></ComboBox>
        <TextBlock Text="上边缘与侧栏冲突" /><ComboBox x:Name="TopConflict"><ComboBoxItem Content="允许同时弹出" /><ComboBoxItem Content="仅最边缘触发" /><ComboBoxItem Content="禁止同时弹出" /></ComboBox>
        <TextBlock Text="下边缘与侧栏冲突" /><ComboBox x:Name="BottomConflict"><ComboBoxItem Content="允许同时弹出" /><ComboBoxItem Content="仅最边缘触发" /><ComboBoxItem Content="禁止同时弹出" /></ComboBox>
      </StackPanel>
    </ScrollViewer>
    <ScrollViewer x:Name="HistorySettings" Grid.Column="1" IsVisible="False">
      <!-- 原历史设置区域；候选与草稿由独立表现模型持有，限制算法在Engine。 -->
      <StackPanel Margin="24" Spacing="14">
        <TextBlock Classes="settings-section" Text="历史记录" FontSize="20" />
        <CheckBox x:Name="SaveHistory" Content="保存历史记录文件" IsChecked="{Binding IsSaveHistory, Mode=TwoWay}" />
        <TextBlock Text="关闭后删除历史文件；本次运行仍可导航，最后打开书籍和书签独立保存。" TextWrapping="Wrap" />
        <TextBlock Classes="settings-section" Text="保存限制" FontSize="16" />
        <TextBlock Text="设置保存在文件中的历史记录上限。应用程序运行期间的历史记录不受限制。" TextWrapping="Wrap" />
        <TextBlock Text="数量限制" />
        <ComboBox x:Name="HistoryLimitSize" ItemsSource="{Binding SizeChoices}" SelectedItem="{Binding SelectedSize, Mode=TwoWay}">
          <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="保留期限" />
        <ComboBox x:Name="HistoryLimitSpan" ItemsSource="{Binding SpanChoices}" SelectedItem="{Binding SelectedSpan, Mode=TwoWay}">
          <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="数量为 0 时不保存访问条目。书签、搜索历史与最后阅读位置独立保留；下次启动按限制载入。" TextWrapping="Wrap" />
        <TextBlock Classes="settings-section" Text="登记与清理" FontSize="16" Margin="0,8,0,0" />
        <TextBlock Text="新书主页面切换次数（0 表示立即登记；已登记书籍一次切换即可更新）" TextWrapping="Wrap" />
        <NumericUpDown x:Name="HistoryEntryPageCount" Minimum="-2147483648" Maximum="2147483647" Increment="1" FormatString="0" Value="{Binding HistoryEntryPageCount, Mode=TwoWay}" />
        <CheckBox x:Name="ForceUpdateHistory" Content="从历史打开也更新访问日期" IsChecked="{Binding IsForceUpdateHistory, Mode=TwoWay}" />
        <CheckBox x:Name="AutoCleanupHistory" Content="启动时自动移除确定不存在的记录" IsChecked="{Binding IsAutoCleanupEnabled, Mode=TwoWay}" />
        <TextBlock Text="权限不足、离线卷和检查失败时保留整批记录。播放时间登记随视频后端迁移。" TextWrapping="Wrap" />
        <TextBlock Text="最近打开书籍数量 · 尚未迁移" Opacity="0.5" />
        <TextBlock Text="保存页面浏览记录 · 尚未迁移" Opacity="0.5" />
      </StackPanel>
    </ScrollViewer>
    <ScrollViewer x:Name="FileSettings" Grid.Column="1" IsVisible="False">
      <StackPanel Margin="16" Spacing="12">
        <TextBlock Classes="settings-section" Text="文件操作" FontSize="18" />
        <CheckBox x:Name="FileWriteAccess" Content="允许修改文件" />
        <CheckBox x:Name="RemoveConfirmed" Content="删除文件前确认" />
        <CheckBox x:Name="ZipWriteAccess" Content="允许删除 ZIP/CBZ 内部条目（永久删除，始终确认）" />
        <CheckBox x:Name="OpenNextBookWhenRemove" Content="删除当前书籍后打开书架相邻项" />
        <TextBlock Text="主页删除处理当前主图片；页面列表可删除显式选中项。删除书籍处理整本目录或根文件。" TextWrapping="Wrap" />
        <TextBlock Text="普通文件或目录送入废纸篓；播放列表仅移除登记；ZIP/CBZ 内部条目永久删除。RAR/7z 内部条目只读。" TextWrapping="Wrap" />
        <TextBlock Text="复制文件时附加路径文本" />
        <ComboBox x:Name="TextCopyPolicy">
          <ComboBoxItem Content="不附加文本" /><ComboBoxItem Content="复制出的文件路径" /><ComboBoxItem Content="原始来源路径" />
        </ComboBox>
        <TextBlock Text="复制归档内文件时" />
        <ComboBox x:Name="ArchiveCopyPolicy">
          <ComboBoxItem Content="仅复制 NeeView 定位" /><ComboBoxItem Content="复制所在归档文件" /><ComboBoxItem Content="复制归档内虚拟路径" /><ComboBoxItem Content="解压并复制文件" />
        </ComboBox>
        <TextBlock Text="虚拟路径用于 NeeView 定位；复制到文件夹会解压归档内文件条目，目录递归提取暂不支持。" TextWrapping="Wrap" />
        <TextBlock Text="复制文件不需要开启修改权限；页组范围可在输入设置的 CopyFile 参数中调整。" TextWrapping="Wrap" />
        <TextBlock Text="剪切暂保留禁用入口，移动可使用分类或移至文件夹。" TextWrapping="Wrap" Opacity="0.5" />
      </StackPanel>
    </ScrollViewer>
    <ScrollViewer x:Name="SettingsSearchPage" Grid.Column="1" IsVisible="False">
      <StackPanel Margin="24" Spacing="8"><TextBlock x:Name="SettingsSearchSummary" FontSize="20" /><StackPanel x:Name="SettingsSearchResults" Spacing="4" /></StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16" Spacing="8">
      <TextBlock x:Name="Message" TextWrapping="Wrap" MaxWidth="560" VerticalAlignment="Center" /><Button x:Name="CancelSettings" Content="取消" Click="Cancel_Click" /><Button x:Name="SaveSettings" Content="保存" Click="Save_Click" />
    </StackPanel>
  </Grid>
</Window>
