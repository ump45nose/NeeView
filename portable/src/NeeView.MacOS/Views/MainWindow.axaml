<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:NeeView.MacOS.Views" x:Class="NeeView.MacOS.Views.MainWindow"
        Width="1200" Height="800" MinWidth="720" MinHeight="480" Title="{Binding Title}" x:CompileBindings="False">
  <!-- 转换自 MainWindow.xaml/SidePanelFrameView.xaml。保持顶部、左右、中间、底部和覆盖层关系。 -->
  <Grid x:Name="Root" RowDefinitions="Auto,*,Auto">
    <Border x:Name="DockMenuSocket" Grid.Row="0" Background="{DynamicResource MenuBar.Background}">
      <StackPanel>
        <!-- 原默认八组菜单由 MenuTree 生成；未迁移命令保留禁用占位。 -->
        <Menu x:Name="MenuBar" />
        <TextBox x:Name="AddressBar" Classes="address" Text="{Binding Address}" PlaceholderText="打开图片、目录、ZIP / RAR / 7z" KeyDown="Address_KeyDown" />
      </StackPanel>
    </Border>
    <Grid x:Name="SidePanelFrame" Grid.Row="1" ColumnDefinitions="41,240,4,*,4,240,41">
      <Border x:Name="LeftRail" Grid.Column="0" Classes="rail" PointerEntered="LeftRail_Entered" PointerExited="LeftRail_Exited"><StackPanel x:Name="LeftRailItems" /></Border>
      <Border x:Name="LeftPanel" Grid.Column="1" Classes="panel" IsVisible="{Binding LeftVisible}" PointerEntered="LeftRail_Entered" PointerExited="LeftRail_Exited"><Grid x:Name="LeftDockHost" /></Border>
      <GridSplitter Grid.Column="2" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" IsVisible="{Binding LeftVisible}" />
      <local:ReaderView x:Name="MainViewSocket" Grid.Column="3" />
      <GridSplitter Grid.Column="4" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" IsVisible="{Binding RightVisible}" />
      <Border x:Name="RightPanel" Grid.Column="5" Classes="panel" IsVisible="{Binding RightVisible}" PointerEntered="RightRail_Entered" PointerExited="RightRail_Exited"><Grid x:Name="RightDockHost" /></Border>
      <Border x:Name="RightRail" Grid.Column="6" Classes="rail" PointerEntered="RightRail_Entered" PointerExited="RightRail_Exited"><StackPanel x:Name="RightRailItems" /></Border>
      <!-- 内部拖放预览由独立表现适配绘制，不改变业务或布局数据。 -->
      <Canvas x:Name="PanelDropPreview" Grid.ColumnSpan="7" IsHitTestVisible="False" />
    </Grid>
    <!-- 面板内容只定义一次；停靠排布与主题独立于各功能视图。 -->
    <Grid x:Name="PanelContentStore" IsVisible="False">
      <Border Tag="FolderPanel"><Grid RowDefinitions="Auto,Auto,Auto,*">
          <StackPanel Margin="8" Spacing="6">
            <TextBlock Text="{Binding FolderPlace}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FolderPlace}" />
            <WrapPanel>
              <Button Content="上一级" Tag="ParentFolder" Click="Command_Click" ToolTip.Tip="浏览书架父目录" />
              <Button Content="进入" Tag="EnterBookshelfFolder" Click="Command_Click" ToolTip.Tip="浏览选中目录，保留当前书籍" />
              <Button Content="同步" Tag="SyncBookshelfFolder" Click="Command_Click" ToolTip.Tip="同步到当前书籍所在书架" />
              <Button Content="刷新" Tag="RefreshBookshelfFolder" Click="Command_Click" ToolTip.Tip="刷新列表并保存当前书架设置，保存失败可重试" />
            </WrapPanel>
          </StackPanel>
          <ComboBox x:Name="FolderOrderView" Grid.Row="1" Margin="8,0,8,6" ToolTip.Tip="普通书架默认排序" ItemsSource="{Binding FolderOrders}" SelectedItem="{Binding SelectedFolderOrder, Mode=OneWay}" SelectionChanged="FolderOrder_Changed">
            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Grid.Row="2" Text="{Binding FolderMessage}" TextWrapping="Wrap" Margin="8,0" />
          <ListBox x:Name="FolderList" Grid.Row="3" ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder, Mode=TwoWay}" DoubleTapped="Folder_DoubleTapped">
            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" /></DataTemplate></ListBox.ItemTemplate>
          </ListBox></Grid></Border>
      <Border Tag="PageListPanel">          <ListBox x:Name="PageList"  ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" SelectionChanged="Page_SelectionChanged">
            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding EntryName}" TextTrimming="CharacterEllipsis" /></DataTemplate></ListBox.ItemTemplate>
          </ListBox></Border>
      <Border Tag="HistoryPanel">          <Grid RowDefinitions="Auto,*">
            <TextBox Text="{Binding HistorySearch}" PlaceholderText="搜索历史" Margin="8" />
            <ListBox x:Name="HistoryList" Grid.Row="1" ItemsSource="{Binding History}" DoubleTapped="History_DoubleTapped">
              <ListBox.ItemTemplate><DataTemplate><StackPanel ToolTip.Tip="{Binding Path}"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Page}" FontSize="10" Opacity="0.6" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </Grid></Border>
      <Border Tag="FileInformationPanel"><ScrollViewer><TextBlock Text="{Binding Information}" TextWrapping="Wrap" Margin="10" /></ScrollViewer></Border>
      <Border Tag="BookmarkPanel">          <Grid RowDefinitions="Auto,*,Auto">
            <WrapPanel Margin="8">
              <Button Content="★" ToolTip.Tip="切换当前书籍书签" Tag="ToggleBookmark" Click="Command_Click" />
              <Button Content="添加" ToolTip.Tip="将当前书籍添加到所选文件夹" Tag="RegisterBookmark" Click="Command_Click" />
              <Button Content="新建" IsEnabled="{Binding CanChooseBookmarkFolder}" ToolTip.Tip="新建书签文件夹" Click="Bookmark_NewFolder" />
              <Button Content="更名" IsEnabled="{Binding IsSingleBookmarkSelection}" Click="Bookmark_Rename" /><Button Content="移除" Click="Bookmark_Remove" />
              <Button Content="↑" IsEnabled="{Binding IsSingleBookmarkSelection}" Tag="-1" ToolTip.Tip="在同一文件夹上移" Click="Bookmark_Reorder" />
              <Button Content="↓" IsEnabled="{Binding IsSingleBookmarkSelection}" Tag="1" ToolTip.Tip="在同一文件夹下移" Click="Bookmark_Reorder" />
              <Button Content="移动…" IsEnabled="{Binding IsSingleBookmarkSelection}" Click="Bookmark_Move" /><Button Content="颜色…" IsEnabled="{Binding IsSingleBookmarkSelection}" Click="Bookmark_Color" />
            </WrapPanel>
            <TreeView x:Name="BookmarkTree" Grid.Row="1" ItemsSource="{Binding Bookmarks}" SelectionMode="Multiple" SelectedItem="{Binding SelectedBookmark, Mode=TwoWay}" DoubleTapped="Bookmark_DoubleTapped">
              <TreeView.ItemTemplate><TreeDataTemplate ItemsSource="{Binding Children}"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="■" IsVisible="{Binding IsFolder}" Foreground="{Binding Color, TargetNullValue='#8CA0AF'}" /><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" /></StackPanel></TreeDataTemplate></TreeView.ItemTemplate>
            </TreeView>
            <StackPanel Grid.Row="2" Margin="8" Spacing="4">
              <TextBlock x:Name="BookmarkDropHint" Text="拖到文件夹中间移入，行边缘调整顺序；空白移至根。" TextWrapping="Wrap" FontSize="10" Opacity="0.7" />
              <Button Content="恢复上次移除" IsEnabled="{Binding CanRestoreBookmarks}" Click="Bookmark_Restore" />
            </StackPanel>
          </Grid></Border>
      <Border Tag="NavigatePanel">          <Grid RowDefinitions="200,Auto">
            <local:ThumbnailView x:Name="Navigator" IsNavigator="True" />
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4" Margin="8"><Button Content="−" Tag="ViewScaleDown" Click="Command_Click" /><Button Content="适合" Tag="SetStretchModeUniform" Click="Command_Click" /><Button Content="100%" Tag="SetStretchModeNone" Click="Command_Click" /><Button Content="+" Tag="ViewScaleUp" Click="Command_Click" /></StackPanel>
          </Grid></Border>
      <Border Tag="ImageEffectPanel"><TextBlock Text="图像效果将在 P5 迁入。" TextWrapping="Wrap" Margin="10" /></Border>
      <Border Tag="PlaylistPanel"><TextBlock Text="播放列表将在 P5 迁入。" TextWrapping="Wrap" Margin="10" /></Border>
      <Border Tag="DestinationFolderPanel"><TextBlock Text="目标文件夹分类将在 P4 迁入。" TextWrapping="Wrap" Margin="10" /></Border>
    </Grid>
    <Border x:Name="DockStatusArea" Grid.Row="2" Background="{DynamicResource BottomBar.Background}" PointerEntered="FilmStrip_Entered" PointerExited="FilmStrip_Exited">
      <StackPanel>
        <!-- 保持原底部插槽，可见窗口缩略图由共享工厂加载。 -->
        <local:ThumbnailView x:Name="DockFilmStripSocket" Height="{Binding FilmStripHeight}" IsVisible="{Binding FilmStripVisible}" />
        <Grid x:Name="DockPageSliderSocket" ColumnDefinitions="*,Auto" Margin="10,0">
          <Slider x:Name="PageSliderView" Grid.Column="0" Minimum="0" Maximum="{Binding LastIndex}" Value="{Binding PageIndex, Mode=OneWay}" IsDirectionReversed="{Binding SliderReversed}" SmallChange="1" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Slider_ValueChanged" />
          <TextBlock Grid.Column="1" Text="{Binding PositionText}" VerticalAlignment="Center" Margin="12,0,0,0" />
        </Grid>
        <TextBlock x:Name="StatusField" Text="{Binding Status}" TextTrimming="CharacterEllipsis" FontSize="11" Margin="10,0,10,5" />
      </StackPanel>
    </Border>
    <Border x:Name="MessageLayer" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14" Padding="12,6" CornerRadius="3" Background="#D9222222" IsVisible="{Binding IsLoading}" IsHitTestVisible="False"><TextBlock Text="正在读取…" /></Border>
  </Grid>
</Window>
