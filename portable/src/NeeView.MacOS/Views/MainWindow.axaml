<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:NeeView.MacOS.Views" x:Class="NeeView.MacOS.Views.MainWindow"
        Width="1200" Height="800" MinWidth="720" MinHeight="480" Title="{Binding Title}" x:CompileBindings="False">
  <!-- 转换自 MainWindow.xaml/SidePanelFrameView.xaml。保持顶部、左右、中间、底部和覆盖层关系。 -->
  <Grid x:Name="Root" RowDefinitions="Auto,*,Auto">
    <Border x:Name="DockMenuSocket" Grid.Row="0" Background="{DynamicResource MenuBar.Background}">
      <StackPanel>
        <!-- 原默认八组菜单由 MenuTree 生成；未迁移命令保留禁用占位。 -->
        <Menu x:Name="MenuBar" />
        <TextBox x:Name="AddressBar" Classes="address" Text="{Binding Address}" PlaceholderText="打开图片、目录、ZIP / RAR / 7z" KeyDown="Address_KeyDown" />
      </StackPanel>
    </Border>
    <Grid x:Name="SidePanelFrame" Grid.Row="1" ColumnDefinitions="41,240,4,*,4,240,41">
      <Border Grid.Column="0" Classes="rail" PointerEntered="LeftRail_Entered" PointerExited="LeftRail_Exited">
        <StackPanel>
          <Button Classes="panel-icon" Tag="FolderPanel" ToolTip.Tip="文件夹" Click="Panel_Click"><PathIcon Data="{DynamicResource g_folder_24px}" /></Button>
          <Button Classes="panel-icon" Tag="PageListPanel" ToolTip.Tip="页面列表" Click="Panel_Click"><PathIcon Data="{DynamicResource g_photo_library_24px}" /></Button>
          <Button Classes="panel-icon" Tag="HistoryPanel" ToolTip.Tip="历史" Click="Panel_Click"><PathIcon Data="{DynamicResource g_history_24px}" /></Button>
        </StackPanel>
      </Border>
      <Border x:Name="LeftPanel" Grid.Column="1" Classes="panel" IsVisible="{Binding LeftVisible}" PointerEntered="LeftRail_Entered" PointerExited="LeftRail_Exited">
        <Grid RowDefinitions="Auto,Auto,*">
          <TextBlock Classes="panel-title" Text="{Binding LeftTitle}" />
          <Button Grid.Row="1" Content="上一级" HorizontalAlignment="Stretch" Margin="8,0,8,6" Tag="ParentFolder" Click="Command_Click" IsVisible="{Binding ShowFolderList}" />
          <ListBox x:Name="FolderList" Grid.Row="2" ItemsSource="{Binding Folders}" DoubleTapped="Folder_DoubleTapped" IsVisible="{Binding ShowFolderList}">
            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <ListBox x:Name="PageList" Grid.Row="2" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" SelectionChanged="Page_SelectionChanged" IsVisible="{Binding ShowPageList}">
            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding EntryName}" TextTrimming="CharacterEllipsis" /></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <Grid Grid.Row="1" Grid.RowSpan="2" RowDefinitions="Auto,*" IsVisible="{Binding ShowHistory}">
            <TextBox Text="{Binding HistorySearch}" PlaceholderText="搜索历史" Margin="8" />
            <ListBox x:Name="HistoryList" Grid.Row="1" ItemsSource="{Binding History}" DoubleTapped="History_DoubleTapped">
              <ListBox.ItemTemplate><DataTemplate><StackPanel ToolTip.Tip="{Binding Path}"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Page}" FontSize="10" Opacity="0.6" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="2" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" IsVisible="{Binding LeftVisible}" />
      <local:ReaderView x:Name="MainViewSocket" Grid.Column="3" />
      <GridSplitter Grid.Column="4" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" IsVisible="{Binding RightVisible}" />
      <Border x:Name="RightPanel" Grid.Column="5" Classes="panel" IsVisible="{Binding RightVisible}" PointerEntered="RightRail_Entered" PointerExited="RightRail_Exited">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Classes="panel-title" Text="{Binding RightTitle}" />

          <ScrollViewer Grid.Row="1" IsVisible="{Binding ShowInformation}"><TextBlock Text="{Binding Information}" TextWrapping="Wrap" Margin="10" /></ScrollViewer>
          <Grid Grid.Row="1" RowDefinitions="Auto,*" IsVisible="{Binding ShowBookmarks}">
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="8">
              <Button Content="★" ToolTip.Tip="切换当前书籍书签" Tag="ToggleBookmark" Click="Command_Click" />
              <Button Content="新建" ToolTip.Tip="新建书签文件夹" Click="Bookmark_NewFolder" />
              <Button Content="更名" Click="Bookmark_Rename" /><Button Content="移除" Click="Bookmark_Remove" />
            </StackPanel>
            <TreeView x:Name="BookmarkTree" Grid.Row="1" ItemsSource="{Binding Bookmarks}" DoubleTapped="Bookmark_DoubleTapped">
              <TreeView.ItemTemplate><TreeDataTemplate ItemsSource="{Binding Children}"><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" /></TreeDataTemplate></TreeView.ItemTemplate>
            </TreeView>
          </Grid>
          <Grid Grid.Row="1" RowDefinitions="200,Auto" IsVisible="{Binding ShowNavigator}">
            <local:ThumbnailView x:Name="Navigator" IsNavigator="True" />
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4" Margin="8"><Button Content="−" Tag="ViewScaleDown" Click="Command_Click" /><Button Content="适合" Tag="SetStretchModeUniform" Click="Command_Click" /><Button Content="100%" Tag="SetStretchModeNone" Click="Command_Click" /><Button Content="+" Tag="ViewScaleUp" Click="Command_Click" /></StackPanel>
          </Grid>
        </Grid>
      </Border>
      <Border Grid.Column="6" Classes="rail" PointerEntered="RightRail_Entered" PointerExited="RightRail_Exited">
        <StackPanel>
          <Button Classes="panel-icon" Tag="FileInformationPanel" ToolTip.Tip="信息" Click="Panel_Click"><PathIcon Data="{DynamicResource g_info_24px}" /></Button>
          <Button Classes="panel-icon" Tag="NavigatePanel" ToolTip.Tip="导航器" Click="Panel_Click"><PathIcon Data="{DynamicResource g_desktop_windows_24px}" /></Button>
          <Button Classes="panel-icon" Tag="ImageEffectPanel" ToolTip.Tip="图像效果（P5）" IsEnabled="False"><PathIcon Data="{DynamicResource g_toy_24px}" /></Button>
          <Button Classes="panel-icon" Tag="BookmarkPanel" ToolTip.Tip="书签" Click="Panel_Click"><PathIcon Data="{DynamicResource g_star_24px}" /></Button>
          <Button Classes="panel-icon" Tag="PlaylistPanel" ToolTip.Tip="播放列表（P5）" IsEnabled="False"><PathIcon Data="{DynamicResource g_playlist_24px}" /></Button>
          <Button Classes="panel-icon" Tag="DestinationFolderPanel" ToolTip.Tip="目标文件夹（P4）" IsEnabled="False"><PathIcon Data="{DynamicResource g_recursive_folder_24px}" /></Button>
        </StackPanel>
      </Border>
    </Grid>
    <Border x:Name="DockStatusArea" Grid.Row="2" Background="{DynamicResource BottomBar.Background}" PointerEntered="FilmStrip_Entered" PointerExited="FilmStrip_Exited">
      <StackPanel>
        <!-- 保持原底部插槽，可见窗口缩略图由共享工厂加载。 -->
        <local:ThumbnailView x:Name="DockFilmStripSocket" Height="112" IsVisible="{Binding FilmStripVisible}" />
        <Grid x:Name="DockPageSliderSocket" ColumnDefinitions="*,Auto" Margin="10,0">
          <Slider x:Name="PageSliderView" Grid.Column="0" Minimum="0" Maximum="{Binding LastIndex}" Value="{Binding PageIndex}" SmallChange="1" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Slider_ValueChanged" />
          <TextBlock Grid.Column="1" Text="{Binding PositionText}" VerticalAlignment="Center" Margin="12,0,0,0" />
        </Grid>
        <TextBlock x:Name="StatusField" Text="{Binding Status}" TextTrimming="CharacterEllipsis" FontSize="11" Margin="10,0,10,5" />
      </StackPanel>
    </Border>
    <Border x:Name="MessageLayer" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14" Padding="12,6" CornerRadius="3" Background="#D9222222" IsVisible="{Binding IsLoading}" IsHitTestVisible="False"><TextBlock Text="正在读取…" /></Border>
  </Grid>
</Window>
