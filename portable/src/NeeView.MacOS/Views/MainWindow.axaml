<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:NeeView.MacOS.Views" x:Class="NeeView.MacOS.Views.MainWindow"
        Width="1200" Height="800" MinWidth="720" MinHeight="480" Title="{Binding Title}" x:CompileBindings="False">
  <!-- 转换自 MainWindow.xaml/SidePanelFrameView.xaml。保持顶部、左右、中间、底部和覆盖层关系。 -->
  <Grid x:Name="Root" RowDefinitions="Auto,*,Auto">
    <Border x:Name="DockMenuSocket" ZIndex="10" Grid.Row="0" Background="{DynamicResource MenuBar.Background}" IsVisible="{Binding MenuVisible}">
      <StackPanel>
        <!-- 原默认八组菜单由 MenuTree 生成；未迁移命令保留禁用占位。 -->
        <Menu x:Name="MenuBar" />
        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding AddressBarVisible}">
          <TextBox x:Name="AddressBar" Classes="address" Text="{Binding Address}" PlaceholderText="打开图片、目录、ZIP / RAR / 7z" KeyDown="Address_KeyDown" />
          <ComboBox x:Name="BrowseModeView" Grid.Column="1" MinWidth="106" MinHeight="28" Padding="8,2" ItemsSource="{Binding BrowseModes}" SelectedItem="{Binding SelectedBrowseMode, Mode=OneWay}" SelectionChanged="BrowseMode_SelectionChanged" ToolTip.Tip="展示方式；瀑布流可滚动速览、双击图片进入分页">
            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>
      </StackPanel>
    </Border>
    <Grid x:Name="SidePanelFrame" Grid.Row="1" ColumnDefinitions="41,240,4,*,4,240,41">
      <local:ReaderView x:Name="MainViewSocket" Grid.Column="3" />
      <local:SimpleProgressBar x:Name="SlideShowTimer" Grid.Column="3" Height="4" VerticalAlignment="Top" Foreground="{DynamicResource Control.Accent}" IsVisible="False" IsHitTestVisible="False" />
      <Border x:Name="LeftRail" Grid.Column="0" Classes="rail" IsVisible="{Binding SideBarVisible}"><StackPanel x:Name="LeftRailItems" /></Border>
      <Border x:Name="LeftPanel" Grid.Column="1" Classes="panel" IsVisible="{Binding LeftVisible}"><Grid x:Name="LeftDockHost" /></Border>
      <GridSplitter Grid.Column="2" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" IsVisible="{Binding LeftVisible}" />
      <GridSplitter Grid.Column="4" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" IsVisible="{Binding RightVisible}" />
      <Border x:Name="RightPanel" Grid.Column="5" Classes="panel" IsVisible="{Binding RightVisible}"><Grid x:Name="RightDockHost" /></Border>
      <Border x:Name="RightRail" Grid.Column="6" Classes="rail" IsVisible="{Binding SideBarVisible}"><StackPanel x:Name="RightRailItems" /></Border>
      <!-- 内部拖放预览由独立表现适配绘制，不改变业务或布局数据。 -->
      <Canvas x:Name="PanelDropPreview" Grid.ColumnSpan="7" IsHitTestVisible="False" />
    </Grid>
    <!-- 面板内容只定义一次；停靠排布与主题独立于各功能视图。 -->
    <Grid x:Name="PanelContentStore" IsVisible="False">
      <Border Tag="FolderPanel"><Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
          <StackPanel Margin="8" Spacing="6">
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding FolderPlace}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FolderPlace}" /><Button x:Name="BookshelfMore" Grid.Column="1" Content="⋯" Click="Bookshelf_More" ToolTip.Tip="书架列表菜单" /></Grid>
            <WrapPanel>
              <Button Content="上一级" Tag="ParentFolder" Click="Command_Click" ToolTip.Tip="浏览书架父目录" />
              <Button Content="进入" Tag="EnterBookshelfFolder" Click="Command_Click" ToolTip.Tip="浏览选中目录，保留当前书籍" />
              <Button Content="同步" Tag="SyncBookshelfFolder" Click="Command_Click" ToolTip.Tip="同步到当前书籍所在书架" />
              <Button Content="刷新" Tag="RefreshBookshelfFolder" Click="Command_Click" ToolTip.Tip="刷新列表并保存当前书架设置，保存失败可重试" />
              <Button Content="书签" Tag="FocusBookmarkList" Click="Command_Click" ToolTip.Tip="在书架浏览书签" />
            </WrapPanel>
          </StackPanel>
          <ComboBox x:Name="FolderOrderView" Grid.Row="1" Margin="8,0,8,6" ToolTip.Tip="当前目录排序；各目录独立保存" ItemsSource="{Binding FolderOrders}" SelectedItem="{Binding SelectedFolderOrder, Mode=OneWay}" SelectionChanged="FolderOrder_Changed">
            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Grid.Row="2" Text="{Binding FolderMessage}" TextWrapping="Wrap" Margin="8,0" />
          <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding FolderSearchVisible}" Margin="8,0,8,4">
            <TextBox x:Name="FolderSearchBox" Text="{Binding FolderSearch.Keyword, Mode=TwoWay}" PlaceholderText="搜索书架" KeyDown="NavigationSearch_KeyDown" LostFocus="NavigationSearch_LostFocus" />
            <Button Grid.Column="1" Content="×" Tag="Folder" Click="NavigationSearch_Clear" Padding="6,0" /><Button Grid.Column="2" Content="▾" Tag="Folder" Click="NavigationSearch_History" Padding="6,0" />
          </Grid>
          <TextBlock Grid.Row="4" Text="{Binding FolderSearch.Error}" Foreground="#D9957C" TextWrapping="Wrap" Margin="8,0" />
          <Grid x:Name="FolderBrowserBody" Grid.Row="5" ColumnDefinitions="0,0,*">
          <local:FolderTreeView x:Name="BookshelfDirectoryTree" IsVisible="False" />
          <GridSplitter x:Name="FolderTreeSplitter" Grid.Column="1" Width="4" ResizeDirection="Columns" DragCompleted="FolderTree_DragCompleted" IsVisible="False" />
          <DockPanel x:Name="BookshelfItems" Grid.Column="2">
          <TreeView x:Name="BookshelfBookmarkTree" DockPanel.Dock="Top" MaxHeight="180" IsVisible="{Binding IsBookmarkPlace}" ItemsSource="{Binding Bookmarks}" SelectionChanged="BookshelfBookmarkTree_Changed">
            <TreeView.ItemTemplate><TreeDataTemplate ItemsSource="{Binding Children}"><TextBlock Text="{Binding DisplayName}" /></TreeDataTemplate></TreeView.ItemTemplate>
          </TreeView>
          <ListBox x:Name="FolderList" Focusable="True" ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder, Mode=TwoWay}" DoubleTapped="Folder_DoubleTapped">
            <ListBox.ContextMenu><ContextMenu><MenuItem Header="打开 / 进入书签文件夹" Click="Bookshelf_Open" /><MenuItem Header="在独立书签面板中定位" Click="Bookshelf_RevealBookmark" /></ContextMenu></ListBox.ContextMenu>

          </ListBox></DockPanel></Grid></Grid></Border>
      <Border Tag="PageListPanel"><Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
          <Grid ColumnDefinitions="*,Auto" Margin="8,4"><TextBlock Text="{Binding PageListTitle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /><Button x:Name="PageListMore" Grid.Column="1" Content="⋯" Click="PageList_More" ToolTip.Tip="页面列表显示和目录" /></Grid>
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding PageSearchVisible}" Margin="8,0,8,4">
            <TextBox x:Name="PageListSearchBox" Text="{Binding PageSearch.Keyword, Mode=TwoWay}" PlaceholderText="搜索页面" KeyDown="NavigationSearch_KeyDown" LostFocus="NavigationSearch_LostFocus" />
            <Button Grid.Column="1" Content="×" Tag="Page" Click="NavigationSearch_Clear" Padding="6,0" /><Button Grid.Column="2" Content="▾" Tag="Page" Click="NavigationSearch_History" Padding="6,0" />
          </Grid>
          <TextBlock Grid.Row="2" Text="{Binding PageSearch.Error}" Foreground="#D9957C" TextWrapping="Wrap" Margin="8,0" />
          <Grid x:Name="PageBrowserBody" Grid.Row="3" ColumnDefinitions="0,0,*">
            <TreeView x:Name="ContentsTree" IsVisible="False" KeyDown="ContentsTree_KeyDown" PointerReleased="ContentsTree_Released">
              <TreeView.Styles><Style Selector="TreeViewItem"><Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" /></Style></TreeView.Styles>
              <TreeView.ItemTemplate><TreeDataTemplate ItemsSource="{Binding Children}"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></TreeDataTemplate></TreeView.ItemTemplate>
            </TreeView>
            <GridSplitter x:Name="ContentsTreeSplitter" Grid.Column="1" Width="4" ResizeDirection="Columns" DragCompleted="ContentsTree_DragCompleted" IsVisible="False" />
            <ListBox x:Name="PageList" Grid.Column="2" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage, Mode=TwoWay}" SelectionMode="Multiple" DoubleTapped="PageList_DoubleTapped" />
          </Grid>
          <TextBlock Grid.Row="4" Text="{Binding PageCount}" IsVisible="{Binding PageCountVisible}" Margin="8,4" FontSize="10" Opacity="0.7" />
        </Grid></Border>
      <Border Tag="HistoryPanel">          <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
            <Grid ColumnDefinitions="*,Auto" Margin="8,4">
              <TextBlock Text="{Binding HistoryPlace}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding HistoryPlace}" />
              <Button x:Name="HistoryMoreButton" Grid.Column="1" Content="⋯" Click="History_More" ToolTip.Tip="历史列表菜单" />
            </Grid>
            <!-- 结构/主题仅消费独立搜索表现，不在控件中解析查询或读取来源。 -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding HistorySearchVisible}" Margin="8,0,8,4">
              <TextBox x:Name="HistorySearchBox" Text="{Binding HistorySearch.Keyword, Mode=TwoWay}" LostFocus="HistorySearch_LostFocus" PlaceholderText="搜索历史" />
              <Button Grid.Column="1" Content="×" Click="HistorySearch_Clear" ToolTip.Tip="清空搜索" Padding="6,0" />
              <Button x:Name="HistorySearchHistoryButton" Grid.Column="2" Content="▾" Click="HistorySearch_History" ToolTip.Tip="搜索历史" Padding="6,0" />
            </Grid>
            <TextBlock x:Name="HistorySearchError" Grid.Row="2" Text="{Binding HistorySearch.Error}" TextWrapping="Wrap" Margin="8,0" FontSize="10" Foreground="#D9957C" />
            <ListBox x:Name="HistoryList" Grid.Row="3" Focusable="True" ItemsSource="{Binding History}" SelectionMode="Multiple" SelectedItem="{Binding SelectedHistory, Mode=TwoWay}" DoubleTapped="History_DoubleTapped" KeyDown="History_KeyDown">
              <ListBox.ContextMenu><ContextMenu Opening="History_ContextOpening"><MenuItem Header="打开书籍" Click="History_Open" /><Separator /><MenuItem Header="移除所选历史记录" Click="History_Remove" /></ContextMenu></ListBox.ContextMenu>

            </ListBox>
            <TextBlock Grid.Row="4" Text="{Binding HistoryCount}" IsVisible="{Binding HistoryCountVisible}" Margin="8,4" FontSize="10" Opacity="0.7" />
          </Grid></Border>
      <Border Tag="FileInformationPanel"><local:FileInformationView x:Name="InformationPanelView" /></Border>
      <Border Tag="BookmarkPanel">          <Grid RowDefinitions="Auto,*,Auto">
            <WrapPanel Margin="8">
              <Button Content="★" ToolTip.Tip="切换当前书籍书签" Tag="ToggleBookmark" Click="Command_Click" />
              <Button Content="添加" ToolTip.Tip="将当前书籍添加到所选文件夹" Tag="RegisterBookmark" Click="Command_Click" />
              <Button Content="新建" IsEnabled="{Binding CanChooseBookmarkFolder}" ToolTip.Tip="新建书签文件夹" Click="Bookmark_NewFolder" />
              <Button Content="更名" IsEnabled="{Binding IsSingleBookmarkSelection}" Click="Bookmark_Rename" /><Button Content="移除" Click="Bookmark_Remove" />
              <Button Content="↑" IsEnabled="{Binding IsSingleBookmarkSelection}" Tag="-1" ToolTip.Tip="在同一文件夹上移" Click="Bookmark_Reorder" />
              <Button Content="↓" IsEnabled="{Binding IsSingleBookmarkSelection}" Tag="1" ToolTip.Tip="在同一文件夹下移" Click="Bookmark_Reorder" />
              <Button Content="移动…" IsEnabled="{Binding IsSingleBookmarkSelection}" Click="Bookmark_Move" /><Button Content="颜色…" IsEnabled="{Binding IsSingleBookmarkSelection}" Click="Bookmark_Color" />
            </WrapPanel>
            <local:BookmarkListView x:Name="BookmarkPanelList" Grid.Row="1">
            <local:BookmarkListView.TreeContent>
            <!-- 导航栏在上，编辑树在固定插槽；拖动提示换行不能使命中行在释放前移动。 -->
            <TreeView x:Name="BookmarkTree" Height="180" IsVisible="{Binding BookmarkTreeVisible}" ItemsSource="{Binding Bookmarks}" SelectionMode="Multiple" SelectedItem="{Binding SelectedBookmark, Mode=TwoWay}" DoubleTapped="Bookmark_DoubleTapped">
              <TreeView.ItemTemplate><TreeDataTemplate ItemsSource="{Binding Children}"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="■" IsVisible="{Binding IsFolder}" Foreground="{Binding Color, TargetNullValue='#8CA0AF'}" /><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" /></StackPanel></TreeDataTemplate></TreeView.ItemTemplate>
            </TreeView>
            </local:BookmarkListView.TreeContent>
            </local:BookmarkListView>
            <StackPanel Grid.Row="2" Margin="8" Spacing="4">
              <TextBlock x:Name="BookmarkDropHint" IsVisible="{Binding BookmarkTreeVisible}" Text="拖到文件夹中间移入，行边缘调整顺序；空白移至根。" TextWrapping="Wrap" FontSize="10" Opacity="0.7" />
              <Button Content="恢复上次移除" IsEnabled="{Binding CanRestoreBookmarks}" Click="Bookmark_Restore" />
            </StackPanel>
          </Grid></Border>
      <Border Tag="NavigatePanel">          <Grid RowDefinitions="200,Auto">
            <local:ThumbnailView x:Name="Navigator" IsNavigator="True" />
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4" Margin="8"><Button Content="−" Tag="ViewScaleDown" Click="Command_Click" /><Button Content="适合" Tag="SetStretchModeUniform" Click="Command_Click" /><Button Content="100%" Tag="SetStretchModeNone" Click="Command_Click" /><Button Content="+" Tag="ViewScaleUp" Click="Command_Click" /></StackPanel>
          </Grid></Border>
      <local:ImageEffectView x:Name="ImageEffectPanelView" Tag="ImageEffectPanel" />
      <Border Tag="PlaylistPanel"><local:PlaylistView x:Name="PlaylistPanelView" /></Border>
      <Border Tag="DestinationFolderPanel"><local:DestinationFolderPanelView x:Name="DestinationPanelView" /></Border>
    </Grid>
    <Border x:Name="DockStatusArea" ZIndex="10" Grid.Row="2" Background="{DynamicResource BottomBar.Background}">
      <StackPanel>
        <!-- 保持原底部插槽，可见窗口缩略图由共享工厂加载。 -->
        <local:ThumbnailView x:Name="DockFilmStripSocket" Height="{Binding FilmStripHeight}" IsVisible="{Binding FilmStripVisible}" />
        <Grid x:Name="SliderArea">
        <Grid x:Name="DockPageSliderSocket" ColumnDefinitions="Auto,*,Auto" Margin="10,0" Height="{Binding SliderThickness}" Opacity="{Binding SliderOpacity}" IsVisible="{Binding SliderVisible}">
          <Slider x:Name="PageSliderView" Grid.Column="1" MinHeight="0" Minimum="0" Maximum="{Binding LastIndex}" Value="{Binding PageIndex, Mode=OneWay}" IsDirectionReversed="{Binding SliderReversed}" SmallChange="1" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Slider_ValueChanged" />
          <local:PageMarkersView x:Name="PageMarkers" Grid.Column="1" Margin="6,0" IsHitTestVisible="False" Indices="{Binding MarkerIndices}" Maximum="{Binding LastIndex}" IsReversed="{Binding SliderReversed}" IsVisible="{Binding SliderMarksVisible}" />
          <!-- 页号编辑/焦点反馈独立于窗口、主题及原正文定位规则。 -->
          <local:SliderTextBox x:Name="PageNumberView" Grid.Column="{Binding SliderNumberColumn}" IsVisible="{Binding SliderNumberVisible}" Margin="8,0" Value="{Binding PageIndex, Mode=OneWay}" Maximum="{Binding LastIndex}" SourceKey="{Binding SliderSource}" />
        </Grid>
        <local:MediaControlView x:Name="DockMediaControlSocket" VerticalAlignment="Bottom" />
        </Grid>
        <TextBlock x:Name="StatusField" Text="{Binding Status}" TextTrimming="CharacterEllipsis" FontSize="11" Margin="10,0,10,5" />
      </StackPanel>
    </Border>
    <!-- 独立胶片条隐藏时迁到覆盖插槽，保留同一内容实例及选择。 -->
    <Border x:Name="LayerFilmStripSocket" ZIndex="11" Grid.RowSpan="3" VerticalAlignment="Bottom" Background="{DynamicResource BottomBar.Background}" />
    <Border x:Name="MessageLayer" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14" Padding="12,6" CornerRadius="3" Background="#D9222222" IsVisible="{Binding IsLoading}" IsHitTestVisible="False"><TextBlock Text="正在读取…" /></Border>
  </Grid>
</Window>
