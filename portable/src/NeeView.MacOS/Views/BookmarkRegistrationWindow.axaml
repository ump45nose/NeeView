<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NeeView.MacOS.Views.BookmarkRegistrationWindow" Width="440" Height="260"
        CanResize="False" WindowStartupLocation="CenterOwner" x:CompileBindings="False">
  <!-- 转换自 AddressBar/BookmarkPopupContent：名称、目标文件夹和完成/添加/移除分组。 -->
  <StackPanel Margin="16" Spacing="10">
    <TextBlock Text="名称" /><TextBox x:Name="BookmarkName" />
    <TextBlock Text="书签文件夹" /><ComboBox x:Name="BookmarkParent" HorizontalAlignment="Stretch" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="取消" x:Name="CancelButton" Tag="None" Click="Decide" />
      <Button Content="完成" x:Name="DoneButton" Click="Done" />
      <Button Content="添加" x:Name="AddButton" Tag="Add" Click="Decide" />
      <Button Content="移除" Tag="Remove" Click="Decide" />
    </StackPanel>
  </StackPanel>
</Window>
