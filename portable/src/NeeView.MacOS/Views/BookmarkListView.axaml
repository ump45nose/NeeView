<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NeeView.MacOS.Views.BookmarkListView" x:CompileBindings="False">
  <!-- 从原 BookmarkListView 的地址/返回/同步/排序/列表区域转换；树编辑由现有宿主保留。 -->
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">
    <Grid ColumnDefinitions="*,Auto" Margin="8,4">
      <TextBlock Text="{Binding Place}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Place}" VerticalAlignment="Center" />
      <Button x:Name="BookmarkMore" Grid.Column="1" Content="⋯" Click="More_Click" ToolTip.Tip="书签列表菜单" />
    </Grid>
    <WrapPanel Grid.Row="1" Margin="8,0,8,4">
      <Button x:Name="BookmarkRootButton" Content="根" Click="Root_Click" ToolTip.Tip="返回书签根目录" />
      <Button x:Name="BookmarkUpButton" Content="返回" IsEnabled="{Binding CanMoveToParent}" Click="Up_Click" />
      <Button x:Name="BookmarkSyncButton" Content="同步" Click="Sync_Click" ToolTip.Tip="定位当前书籍的书签，优先当前目录" />
      <Button Content="刷新" Click="Refresh_Click" ToolTip.Tip="刷新列表及来源元数据" />
      <ComboBox x:Name="BookmarkOrder" ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder, Mode=OneWay}" SelectionChanged="Order_Changed">
        <ComboBox.Styles><Style Selector="ComboBoxItem"><Setter Property="IsEnabled" Value="{Binding IsEnabled}" /></Style></ComboBox.Styles>
        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
    </WrapPanel>
    <!-- 搜索只提交原表达式；主题和控件布局独立于 Engine 查询规则。 -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="8,0,8,4" IsVisible="{Binding SearchVisible}">
      <TextBox x:Name="BookmarkSearchBox" Text="{Binding Keyword, Mode=TwoWay}" PlaceholderText="搜索书签" LostFocus="Search_LostFocus"
               ToolTip.Tip="原搜索语法：名称、/and /or /not、引号、/word、/re /ire、/bookmark /history、/since /until、/size" />
      <Button x:Name="BookmarkSearchClear" Grid.Column="1" Content="×" Click="SearchClear_Click" ToolTip.Tip="清空搜索" />
      <Button x:Name="BookmarkSearchHistory" Grid.Column="2" Content="▾" Click="SearchHistory_Click" ToolTip.Tip="搜索历史" />
    </Grid>
    <TextBlock Grid.Row="3" Text="{Binding CapabilityMessage}" TextWrapping="Wrap" Margin="8,0" FontSize="10" />
    <DockPanel Grid.Row="4">
    <ContentControl x:Name="BookmarkTreeHost" DockPanel.Dock="Top" />
    <ListBox x:Name="BookmarkItems" Focusable="True" SelectionMode="Multiple" SelectionChanged="Item_Changed" DoubleTapped="Item_DoubleTapped">
      <ListBox.ContextMenu><ContextMenu><MenuItem Header="打开 / 进入文件夹" Click="Open_Click" /><MenuItem Header="定位所在书签文件夹" Click="RevealPlace_Click" /></ContextMenu></ListBox.ContextMenu>

    </ListBox>
    </DockPanel>
    <TextBlock Grid.Row="5" Text="{Binding SearchError}" TextWrapping="Wrap" FontSize="10" Margin="8,0" Foreground="#D9957C" />
    <TextBlock Grid.Row="6" Text="{Binding Count}" IsVisible="{Binding CountVisible}" FontSize="10" Margin="8,4" Opacity="0.7" />
  </Grid>
</UserControl>
