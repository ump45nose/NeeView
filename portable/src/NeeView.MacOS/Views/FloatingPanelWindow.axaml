<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NeeView.MacOS.Views.FloatingPanelWindow" Width="320" Height="480"
        MinWidth="180" MinHeight="160" ShowInTaskbar="False" WindowStartupLocation="Manual">
  <!-- 转换原 LayoutPanelWindow。面板内容从唯一停靠宿主转移，主题不参与布局状态。 -->
  <Border Classes="panel">
    <Grid x:Name="PartDragSurface" RowDefinitions="Auto,*">
      <Border x:Name="PartPanelHeader" Background="Transparent" Cursor="SizeAll">
        <TextBlock x:Name="PanelTitle" Classes="panel-title" />
      </Border>
      <Border x:Name="PartContentHost" Grid.Row="1" />
    </Grid>
  </Border>
</Window>
