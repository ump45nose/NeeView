<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NeeView.MacOS.Views.PasswordDialog" Title="归档密码" Width="440" MinHeight="210"
        SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner" x:CompileBindings="False">
  <!-- 转换原Controls/PasswordDialog：非空确认、默认按钮、Enter、Escape及取消。 -->
  <StackPanel Margin="20" Spacing="12">
    <TextBlock x:Name="SourceName" TextWrapping="Wrap" MaxHeight="90" />
    <TextBlock x:Name="IncorrectPassword" Text="密码不正确，请重新输入。" IsVisible="False" TextWrapping="Wrap" />
    <TextBox x:Name="PasswordInput" PasswordChar="●" AutomationProperties.Name="归档密码" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="CancelPassword" Content="取消" IsCancel="True" Click="Cancel" />
      <Button x:Name="AcceptPassword" Content="打开" IsDefault="True" IsEnabled="False" Click="Accept" />
    </StackPanel>
  </StackPanel>
</Window>
